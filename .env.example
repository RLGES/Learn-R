# Learn-R Configuration File


# ============================================
# LLM Provider Selection
# ============================================
# Options: openai, anthropic, google, lmstudio, huggingface
LLM_PROVIDER=openai

# ============================================
# Cloud API Providers
# ============================================

# OpenAI (GPT-4, GPT-4o)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google (Gemini)
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

# ============================================
# Local & Open Source Providers
# ============================================

# LM Studio (Local inference - no API key needed)
# Download from: https://lmstudio.ai/
# Start LM Studio and load a model, then run the local server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Hugging Face Inference API
# Get your token from: https://huggingface.co/settings/tokens
# Can also use HF_TOKEN environment variable
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ============================================
# Advanced Settings
# ============================================

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2048

# Temperature for LLM generation (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.3

# Request timeout in seconds
LLM_TIMEOUT=60

# Enable debug logging for LLM calls
LLM_DEBUG=false
